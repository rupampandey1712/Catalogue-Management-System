FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore
RUN dotnet publish src/Catalogue.Workers/Catalogue.Workers.csproj -c Release -o /app/publish /p:UseAppHost=false

# aspnet base: ServiceDefaults (health/OTel/Serilog) depends on the ASP.NET Core shared framework
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Catalogue.Workers.dll"]
