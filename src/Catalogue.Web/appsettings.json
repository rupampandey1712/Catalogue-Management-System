{
  "Logging": {
    "Json": false,
    "File": {
      "Path": "logs/catalogue-api-.json"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogueDb": "Server=(localdb)\\mssqllocaldb;Database=CatalogueDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": "",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "Jwt": {
    "Issuer": "catalogue-dev"
  },
  "FileStorage": {
    "UseBlob": true,
    "Container": "catalogue-raw"
  },
  "ServiceBus": {
    "Enabled": false,
    "QueueName": "catalogue-imports"
  },
  "SupplierApis": {
    "UseDummyJson": false,
    "DummyJsonBaseUrl": "https://dummyjson.com"
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "EventHub": {
    "Enabled": false,
    "HubName": "catalogue-edi",
    "ConsumerGroup": "catalogue-ingest",
    "PartitionCount": 4,
    "ConsumerInProcess": true,
    "CheckpointContainer": "eventhub-checkpoints",
    "ConcurrentPublishers": 2,
    "SourceDirectory": "../../samples/edi"
  },
  "Storage": {
    "Root": "../../.storage"
  },
  "Media": {
    "Container": "catalogue-media",
    "AllowPrivateNetworks": false
  },
  "Payments": {
    "ReturnBaseUrl": "http://localhost:5173",
    "Simulated": {
      "Enabled": false
    },
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "AllowLiveKeys": false
    }
  },
  "Agent": {
    "Enabled": true,
    "RunTimeout": "00:20:00",
    "MaxQueue": 20,
    "HistoryMessages": 8,
    "MaxToolCallsPerRun": 6,
    "MaxToolResultChars": 1800,
    "FoundryLocal": {
      "Enabled": true,
      "CliPath": "foundry",
      "Model": "ministral-3-3b-instruct-2512",
      "Thinking": "auto",
      "Endpoint": "",
      "AutoStartService": true,
      "AutoLoadModel": true,
      "MaxOutputTokens": 1200,
      "Temperature": 0.2,
      "RequestTimeout": "00:10:00",
      "ModelLoadTimeout": "00:10:00"
    },
    "Review": {
      "Enabled": true,
      "Interval": "12:00:00",
      "UseModel": true,
      "ModelTimeout": "00:12:00"
    }
  }
}
