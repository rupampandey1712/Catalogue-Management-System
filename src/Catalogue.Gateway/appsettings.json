{
  "AllowedHosts": "*",
  "Gateway": {
    "RateLimit": {
      "PerMinute": 1200
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "api",
        "Order": 1,
        "RateLimiterPolicy": "auth",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "uploads": {
        "ClusterId": "api",
        "Order": 2,
        "RateLimiterPolicy": "api",
        "TimeoutPolicy": "long",
        "MaxRequestBodySize": 2148532224,
        "Match": {
          "Path": "/api/{area:regex(^(imports|eventhub)$)}/{**rest}",
          "Methods": [
            "POST"
          ]
        }
      },
      "api": {
        "ClusterId": "api",
        "Order": 10,
        "RateLimiterPolicy": "api",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "swagger": {
        "ClusterId": "api",
        "Order": 20,
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "spa": {
        "ClusterId": "web",
        "Order": 100,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:20:00"
        },
        "Destinations": {
          "api-1": {
            "Address": "http://localhost:5080/"
          }
        }
      },
      "web": {
        "Destinations": {
          "web-1": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  },
  "Logging": {
    "Json": false,
    "File": {
      "Path": "logs/catalogue-gateway-.json"
    }
  },
  "ConnectionStrings": {}
}