{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "DurableTask": "Warning"
    }
  },
  "extensions": {
    "durableTask": {
      "storageProvider": {
        "type": "azureStorage",
        "connectionStringName": "AzureWebJobsStorage"
      },
      "maxConcurrentActivityFunctions": 8
    }
  }
}
