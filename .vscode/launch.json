{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Launch API (Catalogue.Web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Catalogue.Web/bin/Debug/net10.0/Catalogue.Web.dll",
      "args": ["--urls", "http://localhost:5080"],
      "cwd": "${workspaceFolder}/src/Catalogue.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/views": "${workspaceFolder}/Views"
      }
    }
  ]
}
